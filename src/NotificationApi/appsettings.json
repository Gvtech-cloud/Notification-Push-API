{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationDatabase": "Data Source=notifications.db"
  },
  "NotificationSettings": {
    "DeduplicationWindowMinutes": 5,
    "PastDeliveryTimeToleranceSeconds": 30,
    "DefaultBatchSize": 50,
    "EnableBackgroundWorker": false,
    "BackgroundWorkerIntervalSeconds": 10,
    "SimulateProviderFailure": false
  }
}
